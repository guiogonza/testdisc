# Acceso por IP pública con prefijo de ruta /evaluacionesrh
# URL: http://164.68.118.86/evaluacionesrh
#
# Estrategia:
#   - Streamlit corre con STREAMLIT_SERVER_BASE_URL_PATH=evaluacionesrh, por lo
#     que genera todas sus rutas (HTML, JS, _stcore, websocket) bajo /evaluacionesrh/.
#   - El prefijo /evaluacionesrh/ se conserva tal cual al reenviar a Streamlit
#     (sin reescritura), para que coincida con su baseUrlPath.

server {
    listen 80;
    server_name 164.68.118.86;

    client_max_body_size 50M;

    # Redirigir raíz al prefijo de la aplicación
    location = / {
        return 302 /evaluacionesrh;
    }

    # Normalizar /evaluacionesrh sin slash final
    location = /evaluacionesrh {
        proxy_pass http://127.0.0.1:8505;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    # ── Aplicación principal ───────────────────────────────────────────────────
    # Conserva el prefijo /evaluacionesrh/ al reenviar a Streamlit, ya que su
    # baseUrlPath espera recibir las peticiones con ese mismo prefijo.
    location ~ ^/(static|_stcore|media|component|favicon\.png)(/.*)?$ {
        proxy_pass http://127.0.0.1:8505;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    location /evaluacionesrh/ {
        rewrite ^/evaluacionesrh/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:8505;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }
}
